# 가상환경
.venv/
venv/

# 파이썬 캐시
__pycache__/
*.pyc
.pytest_cache/

# 전처리 캐시/결과 (data/README.md 는 유지)
data/*
!data/README.md

# 데이터 파일 (원본 모캡, 캐시, 통계, pickle)
*.bvh
*.npz
*.npy
*.pkl
*.zip

# 임시 폴더 (scratchpad 등)
scratchpad/
tmp/
temp/

# 2단계 이후 학습 결과
experiments/
*.pth

# 논문 PDF (저작권. GitHub 에 올리지 않음)
docs/*.pdf

# 평가/시각화 결과 (scripts/render_samples.py, scripts/eval_lengths.py 가 자동 생성)
outputs/
